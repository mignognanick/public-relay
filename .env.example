# Secrets: set in your host's secret manager; never commit a real .env.
# Public.com API secret key (public.com > Settings > API)
PUBLIC_SECRET=
# Long random string; the same value goes in the TradingView alert message
WEBHOOK_PASSPHRASE=

# PREFLIGHT (default, never places orders) or LIVE
MODE=PREFLIGHT
# Must be exactly I_UNDERSTAND for LIVE to take effect
LIVE_CONFIRM=

# Optional. Blank = first account that reports an options level
PUBLIC_ACCOUNT_ID=

# Guardrails
# Allowed underlyings, comma-separated (empty = nothing allowed)
ALLOWLIST=SPY,QQQ,AAPL
# Max contracts per order
MAX_QTY=1
# Max limit price per contract (2.00 = $200 per contract)
MAX_PREMIUM=2.00
# Accepted orders per ET day (counted separately for PREFLIGHT and LIVE)
MAX_ORDERS_PER_DAY=3
# Max dollars of premium on OPEN orders per ET day (entry notional uses the full quantity)
MAX_DAILY_OPENS=300
# Take-profits and runner closes per ET day. They do not consume MAX_ORDERS_PER_DAY unless the flag below is true.
MAX_EXIT_ORDERS_PER_DAY=6
# true = exits also count toward MAX_ORDERS_PER_DAY (the old rule)
EXITS_COUNT_TOWARD_ORDER_CAP=false
# Reject outside Mon-Fri 09:31-15:55 ET (holidays not detected)
ENFORCE_MARKET_HOURS=true

# Contract selection. Read at process start; defaults match the values below.
# |delta| band. 0 <= min <= max <= 1
DELTA_BAND_MIN=0.50
DELTA_BAND_MAX=0.60
# ATM through this many points in the money (0 = ATM only)
ITM_POINTS=5
# 0 = today (0DTE) in America/New_York. N = that many calendar days later. The chain must list the date.
EXPIRY_DAYS=0
# When the bid/ask mid is missing: ask, bid, or reject
OPEN_LIMIT_FALLBACK=ask
CLOSE_LIMIT_FALLBACK=bid

# Partial take-profit. Reported in PREFLIGHT; not sent as a live order.
# Limit = entry * (1 + TP_PERCENT/100). 20 means 20 percent. Not capped by MAX_PREMIUM.
TP_PERCENT=20
# Fraction of contracts to sell (floor, at least 1 when qty >= 2). 0.50 sells half.
TP_FRACTION=0.50
# true = also take profit a 1-contract position. false = that contract closes on the flatten alert.
TP_SINGLE=false

# Supabase (Project Settings > API). Service-role key: server-side only, never in TradingView.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
