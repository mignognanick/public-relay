{
  "_comment": "Paste ONE object below (without this wrapper) into the TradingView alert Message box. underlying_template lets FlowVWAP send the underlying; the relay selects the 0DTE contract. template/fixed_example still send a full OCC symbol.",
  "underlying_template": {
    "passphrase": "REPLACE_WITH_WEBHOOK_PASSPHRASE",
    "symbol": "{{ticker}}",
    "side": "{{strategy.order.action}}",
    "qty": "{{strategy.order.contracts}}",
    "underlying_price": "{{close}}",
    "market_position": "{{strategy.market_position}}",
    "prev_market_position": "{{strategy.prev_market_position}}",
    "strategy": "FlowVWAP",
    "alert_id": "{{ticker}}-{{strategy.order.id}}-{{timenow}}"
  },
  "template": {
    "passphrase": "REPLACE_WITH_WEBHOOK_PASSPHRASE",
    "symbol": "{{ticker}}261120C00250000",
    "side": "{{strategy.order.action}}",
    "open_close": "OPEN",
    "limit_price": "1.50",
    "qty": 1,
    "alert_id": "{{ticker}}-{{strategy.order.id}}-{{timenow}}"
  },
  "fixed_example": {
    "passphrase": "REPLACE_WITH_WEBHOOK_PASSPHRASE",
    "symbol": "AAPL261120C00250000",
    "side": "BUY",
    "open_close": "OPEN",
    "limit_price": "1.50",
    "qty": 1,
    "alert_id": "aapl-call-2026-10-19-001"
  }
